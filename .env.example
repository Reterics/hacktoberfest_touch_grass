# Ollama runs locally; Moss proxies all AI calls through its backend.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# Port the Moss backend listens on (LAN-exposed).
MOSS_PORT=3000
# Override the LAN host used in the phone QR code if auto-detection picks the wrong adapter.
# MOSS_PUBLIC_HOST=192.168.1.50
# Where the SQLite database lives.
# MOSS_DATA_DIR=./data
